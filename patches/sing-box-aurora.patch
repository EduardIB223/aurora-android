+package xray
+
+import (
+	"context"
+	"testing"
+
+	N "github.com/sagernet/sing/common/network"
+
+	xcore "github.com/xtls/xray-core/core"
+)
+
+type namedDialer struct {
+	N.Dialer
+	name string
+}
+
+func withInstance(inst *xcore.Instance) context.Context {
+	return context.WithValue(context.Background(), xcore.XrayKey(1), inst)
+}
+
+// Two boxes in one process (Android: the VPN and a "ping all" run) must
+// each dial through their own sing-box dialer, and closing one must not
+// leave the other on a dead dialer.
+func TestEachInstanceDialsThroughItsOwnDialer(t *testing.T) {
+	vpn := &Outbound{instance: &xcore.Instance{}, dialer: namedDialer{name: "vpn"}}
+	ping := &Outbound{instance: &xcore.Instance{}, dialer: namedDialer{name: "ping"}}
+	register(vpn)
+	register(ping)
+	t.Cleanup(func() { unregister(vpn); unregister(ping) })
+
+	name := func(ctx context.Context) string {
+		d := dialerFor(ctx)
+		if d == nil {
+			return "<nil>"
+		}
+		return d.(namedDialer).name
+	}
+	if got := name(withInstance(vpn.instance)); got != "vpn" {
+		t.Fatalf("vpn instance dialed through %q", got)
+	}
+	if got := name(withInstance(ping.instance)); got != "ping" {
+		t.Fatalf("ping instance dialed through %q", got)
+	}
+	if got := name(context.Background()); got != "ping" {
+		t.Fatalf("a dial without an instance should use the newest, got %q", got)
+	}
+
+	unregister(ping)
+	if got := name(withInstance(vpn.instance)); got != "vpn" {
+		t.Fatalf("after the ping run closed, vpn dialed through %q", got)
+	}
+	if got := name(context.Background()); got != "vpn" {
+		t.Fatalf("after the ping run closed, the fallback is %q", got)
+	}
+}
