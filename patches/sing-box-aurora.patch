From 967b71f198fc509c98ecdefc73a93754a346cf11 Mon Sep 17 00:00:00 2001
From: orangpt <orangpthub@gmail.com>
Date: Wed, 23 Sep 2026 15:43:57 +0300
Subject: [PATCH 4/4] xray: give each instance its own sing-box dialer

On Android the "ping all" box runs in the VPN's process. It replaced the
one process-wide dialer, so after it closed the VPN's xray outbounds dialed
through a dead one. Look the dialer up by the xray instance xray puts in
every dial's context; the newest covers dials without one.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 protocol/xray/outbound.go      | 56 ++++++++++++++++++++++++++++------
 protocol/xray/outbound_test.go | 55 +++++++++++++++++++++++++++++++++
 2 files changed, 102 insertions(+), 9 deletions(-)
 create mode 100644 protocol/xray/outbound_test.go

diff --git a/protocol/xray/outbound.go b/protocol/xray/outbound.go
index b3433ae..06713ce 100644
--- a/protocol/xray/outbound.go
+++ b/protocol/xray/outbound.go
@@ -41,24 +41,41 @@ type Outbound struct {
 	outbound.Adapter
 	logger   logger.ContextLogger
 	instance *xcore.Instance
+	dialer   N.Dialer
 }
 
 // xray-core dials through a process-wide "system dialer". Pointing it at a
 // sing-box dialer makes its sockets follow sing-box's interface binding
 // (and on Android the VpnService protect call), so they leave through the
 // physical network instead of looping back into our own TUN.
+//
+// Several boxes can live in one process — on Android the "ping all"
+// instance runs next to the VPN — so each xray instance keeps its own
+// sing-box dialer, found through the instance xray puts in every dial's
+// context. The newest one covers a dial without it.
 var (
 	dialerAccess sync.RWMutex
-	singDialer   N.Dialer
+	dialers      = map[*xcore.Instance]*Outbound{}
+	newest       *Outbound
 	installOnce  sync.Once
 )
 
+func dialerFor(ctx context.Context) N.Dialer {
+	dialerAccess.RLock()
+	defer dialerAccess.RUnlock()
+	if h, ok := dialers[xcore.FromContext(ctx)]; ok {
+		return h.dialer
+	}
+	if newest != nil {
+		return newest.dialer
+	}
+	return nil
+}
+
 type systemDialer struct{}
 
 func (systemDialer) Dial(ctx context.Context, _ xnet.Address, destination xnet.Destination, _ *xinternet.SocketConfig) (net.Conn, error) {
-	dialerAccess.RLock()
-	d := singDialer
-	dialerAccess.RUnlock()
+	d := dialerFor(ctx)
 	if d == nil {
 		return nil, E.New("xray: no dialer configured")
 	}
@@ -79,9 +96,6 @@ func NewOutbound(ctx context.Context, router adapter.Router, logger log.ContextL
 	if err != nil {
 		return nil, err
 	}
-	dialerAccess.Lock()
-	singDialer = outboundDialer
-	dialerAccess.Unlock()
 	installOnce.Do(func() {
 		xinternet.UseAlternativeSystemDialer(systemDialer{})
 	})
@@ -98,11 +112,34 @@ func NewOutbound(ctx context.Context, router adapter.Router, logger log.ContextL
 	if err != nil {
 		return nil, E.Cause(err, "create xray instance")
 	}
-	return &Outbound{
+	h := &Outbound{
 		Adapter:  outbound.NewAdapterWithDialerOptions(C.TypeXray, tag, []string{N.NetworkTCP, N.NetworkUDP}, options.DialerOptions),
 		logger:   logger,
 		instance: instance,
-	}, nil
+		dialer:   outboundDialer,
+	}
+	register(h)
+	return h, nil
+}
+
+func register(h *Outbound) {
+	dialerAccess.Lock()
+	dialers[h.instance] = h
+	newest = h
+	dialerAccess.Unlock()
+}
+
