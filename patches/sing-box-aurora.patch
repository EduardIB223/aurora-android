+package option
+
+import "github.com/sagernet/sing/common/json"
+
+// XrayOutboundOptions runs one Xray outbound inside an embedded xray-core,
+// for transports sing-box does not implement (XHTTP), with the exact
+// settings a subscription ships — no lossy translation into sing-box's
+// option types.
+type XrayOutboundOptions struct {
+	DialerOptions
+	// A complete Xray outbound object: protocol, settings, streamSettings.
+	Outbound json.RawMessage `json:"outbound"`
+}
diff --git a/protocol/xray/outbound.go b/protocol/xray/outbound.go
new file mode 100644
index 0000000..b3433ae
--- /dev/null
+++ b/protocol/xray/outbound.go
@@ -0,0 +1,151 @@
+// Package xray runs a single Xray outbound inside an embedded xray-core so
+// sing-box can use transports it lacks natively — above all XHTTP, the
+// transport whitelist-bypass servers in Russia rely on (a Russian IP behind
+// a whitelisted TLS name). The outbound JSON from the subscription is handed
+// to xray-core untouched; sing-box only sees a dialer.
+package xray
+
+import (
+	"bytes"
+	"context"
+	"net"
+	"sync"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/adapter/outbound"
+	"github.com/sagernet/sing-box/common/dialer"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/common/logger"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+
+	xnet "github.com/xtls/xray-core/common/net"
+	xcore "github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/infra/conf/serial"
+	xinternet "github.com/xtls/xray-core/transport/internet"
+
+	// Protocols and transports the embedded core can run.
+	_ "github.com/xtls/xray-core/main/distro/all"
+)
+
+func RegisterOutbound(registry *outbound.Registry) {
+	outbound.Register[option.XrayOutboundOptions](registry, C.TypeXray, NewOutbound)
+}
+
+var _ adapter.Outbound = (*Outbound)(nil)
+
+type Outbound struct {
+	outbound.Adapter
+	logger   logger.ContextLogger
+	instance *xcore.Instance
+}
+
+// xray-core dials through a process-wide "system dialer". Pointing it at a
+// sing-box dialer makes its sockets follow sing-box's interface binding
+// (and on Android the VpnService protect call), so they leave through the
+// physical network instead of looping back into our own TUN.
+var (
+	dialerAccess sync.RWMutex
+	singDialer   N.Dialer
+	installOnce  sync.Once
+)
+
+type systemDialer struct{}
+
+func (systemDialer) Dial(ctx context.Context, _ xnet.Address, destination xnet.Destination, _ *xinternet.SocketConfig) (net.Conn, error) {
+	dialerAccess.RLock()
+	d := singDialer
+	dialerAccess.RUnlock()
+	if d == nil {
+		return nil, E.New("xray: no dialer configured")
+	}
+	network := N.NetworkTCP
+	if destination.Network == xnet.Network_UDP {
+		network = N.NetworkUDP
+	}
+	return d.DialContext(ctx, network, M.ParseSocksaddrHostPort(destination.Address.String(), uint16(destination.Port)))
+}
+
+func (systemDialer) DestIpAddress() net.IP { return nil }
+
+func NewOutbound(ctx context.Context, router adapter.Router, logger log.ContextLogger, tag string, options option.XrayOutboundOptions) (adapter.Outbound, error) {
+	if len(options.Outbound) == 0 {
+		return nil, E.New("missing xray outbound")
+	}
+	outboundDialer, err := dialer.New(ctx, options.DialerOptions, true)
+	if err != nil {
+		return nil, err
+	}
+	dialerAccess.Lock()
+	singDialer = outboundDialer
+	dialerAccess.Unlock()
+	installOnce.Do(func() {
+		xinternet.UseAlternativeSystemDialer(systemDialer{})
+	})
+
+	var config bytes.Buffer
+	config.WriteString(`{"log":{"loglevel":"warning"},"outbounds":[`)
+	config.Write(options.Outbound)
+	config.WriteString(`]}`)
+	coreConfig, err := serial.LoadJSONConfig(&config)
+	if err != nil {
+		return nil, E.Cause(err, "parse xray outbound")
+	}
+	instance, err := xcore.New(coreConfig)
+	if err != nil {
+		return nil, E.Cause(err, "create xray instance")
+	}
+	return &Outbound{
+		Adapter:  outbound.NewAdapterWithDialerOptions(C.TypeXray, tag, []string{N.NetworkTCP, N.NetworkUDP}, options.DialerOptions),
+		logger:   logger,
+		instance: instance,
+	}, nil
+}
+
+func (h *Outbound) Start(stage adapter.StartStage) error {
+	if stage != adapter.StartStateStart {
+		return nil
+	}
+	return h.instance.Start()
+}
+
+func (h *Outbound) Close() error {
+	return h.instance.Close()
+}
+
+func destinationOf(network xnet.Network, d M.Socksaddr) xnet.Destination {
+	var address xnet.Address
+	if d.IsFqdn() {
+		address = xnet.DomainAddress(d.Fqdn)
+	} else {
+		address = xnet.IPAddress(d.Addr.AsSlice())
+	}
+	return xnet.Destination{Network: network, Address: address, Port: xnet.Port(d.Port)}
+}
+
+func (h *Outbound) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	ctx, metadata := adapter.ExtendContext(ctx)
+	metadata.Outbound = h.Tag()
+	metadata.Destination = destination
+	switch N.NetworkName(network) {
+	case N.NetworkTCP:
+		h.logger.InfoContext(ctx, "outbound connection to ", destination)
+		return xcore.Dial(ctx, h.instance, destinationOf(xnet.Network_TCP, destination))
+	case N.NetworkUDP:
+		h.logger.InfoContext(ctx, "outbound packet connection to ", destination)
+		return xcore.Dial(ctx, h.instance, destinationOf(xnet.Network_UDP, destination))
+	default:
+		return nil, E.Extend(N.ErrUnknownNetwork, network)
+	}
+}
+
+func (h *Outbound) ListenPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
+	ctx, metadata := adapter.ExtendContext(ctx)
+	metadata.Outbound = h.Tag()
+	metadata.Destination = destination
+	h.logger.InfoContext(ctx, "outbound packet connection to ", destination)
+	return xcore.DialUDP(ctx, h.instance)
+}
